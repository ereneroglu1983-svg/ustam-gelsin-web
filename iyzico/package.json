{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc && npm run copy:data",
    "copy:data": "node -e \"const fs=require('fs'); fs.mkdirSync('lib/data',{recursive:true}); fs.copyFileSync('src/data/sehirler.json','lib/data/sehirler.json'); fs.copyFileSync('src/data/ilceler.json','lib/data/ilceler.json');\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "20.11.19",
    "typescript": "^5.4.0"
  },
  "private": true
}